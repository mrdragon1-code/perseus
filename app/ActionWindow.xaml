<Window x:Class="Perseus.App.ActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PERSEUS" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen" Topmost="True">
    <Border x:Name="Outline" BorderBrush="{StaticResource Accent}" BorderThickness="1" Margin="10" Padding="20">
        <StackPanel>
            <TextBlock x:Name="Heading" Text="▲ PERSEUS // CIFRA" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}" />
            <TextBlock x:Name="PathText" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,6,0,14" FontSize="12" />

            <StackPanel x:Name="AuthPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource Caption}" Text="FATTORE // PASSWORD" />
                <PasswordBox x:Name="PwBox" KeyDown="PwBox_KeyDown" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AuthButton" Content="AUTENTICA" Click="Auth_Click" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="Volto e voce: disponibili con i prossimi moduli." />
            </StackPanel>

            <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,10"
                         Background="{StaticResource Panel}" Foreground="{StaticResource Accent}" BorderThickness="0" />

            <TextBlock x:Name="StateText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Dim}" Text="IN ATTESA" />
            <TextBlock x:Name="DetailText" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <ListBox x:Name="Failures" MaxHeight="160" Margin="0,10,0,0" Visibility="Collapsed" FontSize="11" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="OpenMain" Content="APRI PERSEUS" Visibility="Collapsed" Click="OpenMain_Click" />
                <Button Content="CHIUDI" Margin="0" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
