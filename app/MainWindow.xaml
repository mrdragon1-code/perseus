<Window x:Class="Perseus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Perseus.App.ViewModels"
        Title="PERSEUS" Width="1280" Height="800" MinWidth="980" MinHeight="640"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </Window.Resources>

    <Grid>
        <DockPanel Margin="18">
            <!-- Barra superiore -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="▲ PERSEUS" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="  //  ACCESS CONTROL &amp; VAULT" FontSize="14" Foreground="{StaticResource Dim}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LockoutText}" Foreground="{StaticResource Warn}" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <Border BorderBrush="{Binding StateBrush}" BorderThickness="1" Padding="12,4">
                        <TextBlock Text="{Binding StateLabel, StringFormat=STATUS: {0}}" Foreground="{Binding StateBrush}" FontWeight="Bold" />
                    </Border>
                </StackPanel>
            </Grid>

            <TabControl>
                <!-- ================= CONSOLE ================= -->
                <TabItem Header="CONSOLE">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="190" />
                        </Grid.RowDefinitions>

                        <!-- Feed camera -->
                        <Border Style="{StaticResource Card}" Padding="0" BorderBrush="{Binding StateBrush}">
                            <Grid Background="Black">
                                <Image Source="{Binding Frame}" Stretch="Uniform" />
                                <TextBlock Text="NO SIGNAL" FontSize="22" Foreground="{StaticResource Dim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Frame}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding CameraLabel}" Margin="12,10" FontSize="11"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Top" />
                                <!-- Banner OSTILE -->
                                <Border VerticalAlignment="Bottom" Background="#CCFF3B3B" Padding="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Hostile">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="⚠ NON AUTORIZZATO — SOGGETTO OSTILE" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Pannello autenticazione -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}" BorderBrush="{Binding StateBrush}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="STATO ACCESSO" />
                                    <TextBlock Text="{Binding StateLabel}" FontSize="26" FontWeight="Bold" Foreground="{Binding StateBrush}" />
                                    <TextBlock Text="{Binding StateDetail}" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="FATTORE // PASSWORD" />
                                    <PasswordBox x:Name="PwBox" KeyDown="PwBox_KeyDown" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="AUTENTICA" Click="Unlock_Click" IsEnabled="{Binding SetupDone}" />
                                        <Button Content="BLOCCA" Style="{StaticResource DangerButton}" Command="{Binding LockCommand}"
                                                IsEnabled="{Binding Unlocked}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="FATTORE // VOLTO + LIVENESS" />
                                    <TextBlock Text="Modulo in arrivo (fase 3–4)" Foreground="{StaticResource Dim}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="FATTORE // VOCE" />
                                    <TextBlock Text="Modulo in arrivo (fase 5)" Foreground="{StaticResource Dim}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Log eventi -->
                        <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="EVENT LOG" />
                                <ListBox ItemsSource="{Binding Log}" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" TextWrapping="Wrap">
                                                <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource Dim}" />
                                                <Run Text="{Binding Tag, Mode=OneWay, StringFormat=' [{0}] '}" Foreground="{StaticResource Accent}" />
                                                <Run Text="{Binding Text, Mode=OneWay}" Foreground="{Binding Color, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ================= CARTELLE ================= -->
                <TabItem Header="CARTELLE">
                    <DockPanel Margin="0,12,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Margin="0" Command="{Binding ToggleShellCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="ATTIVA MENU TASTO DESTRO" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShellRegistered}" Value="True">
                                                <Setter Property="Content" Value="✔ MENU TASTO DESTRO ATTIVO (rimuovi)" />
                                                <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Ok}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding Unlocked}">
                                <Button Content="+ AGGIUNGI CARTELLA" Command="{Binding AddFolderCommand}" />
                                <Button Content="CIFRA TUTTO" Command="{Binding EncryptAllCommand}" />
                                <Button Content="DECIFRA TUTTO" Command="{Binding DecryptAllCommand}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,10"
                                   Text="Le modifiche richiedono lo stato AUTORIZZATO. 'BLOCCA' ricifra tutto e rimuove la chiave dalla memoria." />
                        <ListBox ItemsSource="{Binding Folders}" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6,10">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="RIMUOVI" Style="{StaticResource DangerButton}" Margin="0"
                                                    Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.Unlocked, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Path}" FontSize="14" />
                                                <TextBlock Foreground="{StaticResource Dim}" FontSize="11">
                                                    <Run Text="cifrati: " /><Run Text="{Binding Encrypted, Mode=OneWay}" Foreground="{StaticResource Ok}" />
                                                    <Run Text="   in chiaro: " /><Run Text="{Binding Plain, Mode=OneWay}" Foreground="{StaticResource Warn}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <!-- ================= SENSORI ================= -->
                <TabItem Header="SENSORI">
                    <DockPanel Margin="0,12,0,0">
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="ALLOWLIST CAMERE (nomi separati da virgola). OBS e camere virtuali simili sono SEMPRE bloccate." />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="SALVA" Margin="8,0,0,0" Command="{Binding SaveAllowListCommand}"
                                            IsEnabled="{Binding Unlocked}" />
                                    <TextBox Text="{Binding AllowList, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Button DockPanel.Dock="Top" Content="AGGIORNA ELENCO" HorizontalAlignment="Left" Margin="0,0,0,12"
                                Command="{Binding RefreshCamerasCommand}" />
                        <ListBox ItemsSource="{Binding Cameras}" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6,10">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="USA" Margin="0" IsEnabled="{Binding Trusted}"
                                                    Command="{Binding DataContext.OpenCameraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource Dim}">
                                                    <Run Text="{Binding VerdictLabel, Mode=OneWay}" FontWeight="Bold" />
                                                    <Run Text="{Binding Verdict.Reason, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- ================= PRIMO AVVIO ================= -->
        <Grid Background="#F20A0E13" x:Name="SetupOverlay">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SetupDone}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{StaticResource Card}" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="INIZIALIZZAZIONE VAULT" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,12" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warn}" Margin="0,0,0,16"
                               Text="La password è l'UNICO modo per recuperare i file se volto e voce non funzionano più. Se la perdi, i file cifrati sono persi per sempre. Minimo 8 caratteri." />
                    <TextBlock Style="{StaticResource Caption}" Text="PASSWORD" />
                    <PasswordBox x:Name="SetupPw1" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource Caption}" Text="CONFERMA PASSWORD" />
                    <PasswordBox x:Name="SetupPw2" Margin="0,0,0,16" />
                    <Button Content="CREA CHIAVE MASTER" HorizontalAlignment="Left" Click="Setup_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
